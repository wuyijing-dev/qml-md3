@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 COMPONENTS Quick QuickControls2 QuickEffects QuickShapesPrivate REQUIRED)
if (UNIX AND NOT APPLE)
    find_dependency(Qt6 COMPONENTS Widgets DBus REQUIRED)
endif()

# Recorded at package time
set(_MD3_NEEDS_KWINDOWSYSTEM @MD3_PACKAGE_NEEDS_KWINDOWSYSTEM@)
set(_MD3_PACKAGE_SHARED @MD3_PACKAGE_SHARED@)
set(Md3_SHARED ${_MD3_PACKAGE_SHARED})

set(_MD3_PREFIX "${PACKAGE_PREFIX_DIR}")
set(_MD3_LIBDIR "${_MD3_PREFIX}/@CMAKE_INSTALL_LIBDIR@")
set(_MD3_BINDIR "${_MD3_PREFIX}/@CMAKE_INSTALL_BINDIR@")
set(_MD3_INCLUDEDIR "${_MD3_PREFIX}/@CMAKE_INSTALL_INCLUDEDIR@")
set(_MD3_QMLDIR "${_MD3_LIBDIR}/qml")
set(_MD3_QML_MODULE_DIR "${_MD3_QMLDIR}/Md3")
set(_MD3_STUBDIR "${_MD3_LIBDIR}/Md3/stubs")

# Prefer shared or static names depending on how the package was built
set(_MD3_CORE_LIB "")
set(_MD3_CORE_IMPLIB "")
if (_MD3_PACKAGE_SHARED)
    foreach (_n IN ITEMS libMd3.so Md3.dll libMd3.dylib)
        if (EXISTS "${_MD3_LIBDIR}/${_n}")
            set(_MD3_CORE_LIB "${_MD3_LIBDIR}/${_n}")
            break()
        endif()
        if (EXISTS "${_MD3_BINDIR}/${_n}")
            set(_MD3_CORE_LIB "${_MD3_BINDIR}/${_n}")
            break()
        endif()
    endforeach()
    # SONAME variants: libMd3.so.0.1.0
    if (_MD3_CORE_LIB STREQUAL "")
        file(GLOB _md3_so_cands "${_MD3_LIBDIR}/libMd3.so*")
        if (_md3_so_cands)
            list(GET _md3_so_cands 0 _MD3_CORE_LIB)
        endif()
    endif()
    foreach (_n IN ITEMS libMd3.dll.a Md3.lib libMd3.lib)
        if (EXISTS "${_MD3_LIBDIR}/${_n}")
            set(_MD3_CORE_IMPLIB "${_MD3_LIBDIR}/${_n}")
            break()
        endif()
    endforeach()
    # Fallback: import lib alone (MSVC) — treat as shared
    if (_MD3_CORE_LIB STREQUAL "" AND _MD3_CORE_IMPLIB)
        set(_MD3_CORE_LIB "${_MD3_CORE_IMPLIB}")
    endif()
else()
    foreach (_n IN ITEMS libMd3.a libMd3.lib Md3.lib libMd3.dll.a)
        if (EXISTS "${_MD3_LIBDIR}/${_n}")
            set(_MD3_CORE_LIB "${_MD3_LIBDIR}/${_n}")
            break()
        endif()
    endforeach()
endif()

set(_MD3_PLUGIN_LIB "")
set(_MD3_PLUGIN_IMPLIB "")
if (_MD3_PACKAGE_SHARED)
    foreach (_n IN ITEMS libMd3plugin.so Md3plugin.dll libMd3plugin.dylib)
        if (EXISTS "${_MD3_LIBDIR}/${_n}")
            set(_MD3_PLUGIN_LIB "${_MD3_LIBDIR}/${_n}")
            break()
        endif()
        if (EXISTS "${_MD3_BINDIR}/${_n}")
            set(_MD3_PLUGIN_LIB "${_MD3_BINDIR}/${_n}")
            break()
        endif()
    endforeach()
    if (_MD3_PLUGIN_LIB STREQUAL "")
        file(GLOB _plug_so_cands "${_MD3_LIBDIR}/libMd3plugin.so*")
        if (_plug_so_cands)
            list(GET _plug_so_cands 0 _MD3_PLUGIN_LIB)
        endif()
    endif()
    foreach (_n IN ITEMS libMd3plugin.dll.a Md3plugin.lib libMd3plugin.lib)
        if (EXISTS "${_MD3_LIBDIR}/${_n}")
            set(_MD3_PLUGIN_IMPLIB "${_MD3_LIBDIR}/${_n}")
            break()
        endif()
    endforeach()
    # Qt installs the QML plugin import lib beside qmldir (lib/qml/Md3/)
    if (_MD3_PLUGIN_IMPLIB STREQUAL "")
        foreach (_n IN ITEMS Md3plugin.lib libMd3plugin.dll.a libMd3plugin.lib)
            if (EXISTS "${_MD3_QML_MODULE_DIR}/${_n}")
                set(_MD3_PLUGIN_IMPLIB "${_MD3_QML_MODULE_DIR}/${_n}")
                break()
            endif()
        endforeach()
    endif()
    if (EXISTS "${_MD3_QML_MODULE_DIR}/Md3plugin.dll")
        set(_MD3_PLUGIN_LIB "${_MD3_QML_MODULE_DIR}/Md3plugin.dll")
    endif()
else()
    foreach (_n IN ITEMS libMd3plugin.a libMd3plugin.lib Md3plugin.lib libMd3plugin.dll.a)
        if (EXISTS "${_MD3_LIBDIR}/${_n}")
            set(_MD3_PLUGIN_LIB "${_MD3_LIBDIR}/${_n}")
            break()
        endif()
    endforeach()
endif()

if (_MD3_CORE_LIB STREQUAL "")
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "Md3 package incomplete: no libMd3 under ${_MD3_LIBDIR}. "
        "Rebuild with scripts/package-linux.sh or cmake --install.")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
endif()

# Windows: MSVC import libs (.lib) and MinGW import libs (.dll.a) are not interchangeable.
if (WIN32 AND _MD3_PACKAGE_SHARED AND _MD3_CORE_IMPLIB)
    if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND _MD3_CORE_IMPLIB MATCHES "\\.lib$")
        message(FATAL_ERROR
            "Md3 package was built with MSVC (${_MD3_CORE_IMPLIB}) but you are using MinGW.\n"
            "Rebuild Md3 for MinGW, then replace Md3/ beside your project:\n"
            "  scripts/package-windows.ps1 -CmakePrefixPath \"D:/Qt/<ver>/mingw_64\"")
    elseif (CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND _MD3_CORE_IMPLIB MATCHES "\\.dll\\.a$")
        message(FATAL_ERROR
            "Md3 package was built with MinGW (${_MD3_CORE_IMPLIB}) but you are using MSVC.\n"
            "Rebuild Md3 for MSVC, then replace Md3/ beside your project:\n"
            "  scripts/package-windows.ps1 -CmakePrefixPath \"D:/Qt/<ver>/msvc2022_64\"")
    endif()
endif()

if (NOT TARGET Md3::Md3)
    if (_MD3_PACKAGE_SHARED)
        add_library(Md3::Md3 SHARED IMPORTED GLOBAL)
        set_target_properties(Md3::Md3 PROPERTIES
            IMPORTED_LOCATION "${_MD3_CORE_LIB}"
            INTERFACE_INCLUDE_DIRECTORIES "${_MD3_INCLUDEDIR}/Md3;${_MD3_INCLUDEDIR}"
            INTERFACE_LINK_LIBRARIES "Qt6::Quick;Qt6::QuickControls2;Qt6::QuickEffects;Qt6::QuickShapesPrivate"
        )
        if (_MD3_CORE_IMPLIB)
            set_target_properties(Md3::Md3 PROPERTIES IMPORTED_IMPLIB "${_MD3_CORE_IMPLIB}")
        endif()
        set_property(TARGET Md3::Md3 APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS MD3_SHARED)
        if (WIN32 AND _MD3_CORE_IMPLIB)
            foreach (_cfg IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
                set_target_properties(Md3::Md3 PROPERTIES
                    "IMPORTED_LOCATION_${_cfg}" "${_MD3_CORE_LIB}"
                    "IMPORTED_IMPLIB_${_cfg}" "${_MD3_CORE_IMPLIB}"
                )
            endforeach()
        endif()
    else()
        add_library(Md3::Md3 STATIC IMPORTED GLOBAL)
        set_target_properties(Md3::Md3 PROPERTIES
            IMPORTED_LOCATION "${_MD3_CORE_LIB}"
            INTERFACE_INCLUDE_DIRECTORIES "${_MD3_INCLUDEDIR}/Md3;${_MD3_INCLUDEDIR}"
            INTERFACE_LINK_LIBRARIES "Qt6::Quick;Qt6::QuickControls2;Qt6::QuickEffects;Qt6::QuickShapesPrivate"
        )
    endif()
    if (UNIX AND NOT APPLE)
        set_property(TARGET Md3::Md3 APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES Qt6::Widgets Qt6::DBus)
        if (_MD3_NEEDS_KWINDOWSYSTEM)
            find_package(KF6WindowSystem QUIET)
            if (KF6WindowSystem_FOUND)
                set_property(TARGET Md3::Md3 APPEND PROPERTY
                    INTERFACE_LINK_LIBRARIES KF6::WindowSystem)
            else()
                find_package(KF5WindowSystem QUIET)
                if (KF5WindowSystem_FOUND)
                    set_property(TARGET Md3::Md3 APPEND PROPERTY
                        INTERFACE_LINK_LIBRARIES KF5::WindowSystem)
                else()
                    message(FATAL_ERROR
                        "This Md3 package was built with KDE WindowSystem, but "
                        "KF6WindowSystem/KF5WindowSystem was not found. "
                        "Install libkf6windowsystem-dev (or rebuild Md3 without KF).")
                endif()
            endif()
        else()
            find_package(KF6WindowSystem QUIET)
            if (KF6WindowSystem_FOUND)
                set_property(TARGET Md3::Md3 APPEND PROPERTY
                    INTERFACE_LINK_LIBRARIES KF6::WindowSystem)
            else()
                find_package(KF5WindowSystem QUIET)
                if (KF5WindowSystem_FOUND)
                    set_property(TARGET Md3::Md3 APPEND PROPERTY
                        INTERFACE_LINK_LIBRARIES KF5::WindowSystem)
                endif()
            endif()
        endif()
    endif()
    if (WIN32)
        set_property(TARGET Md3::Md3 APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES dwmapi shell32 shlwapi ole32 propsys advapi32)
    endif()
endif()

if (NOT TARGET Md3)
    add_library(Md3 ALIAS Md3::Md3)
endif()

if (_MD3_PLUGIN_LIB AND NOT TARGET Md3plugin)
    if (_MD3_PACKAGE_SHARED)
        add_library(Md3plugin SHARED IMPORTED GLOBAL)
        set_target_properties(Md3plugin PROPERTIES
            IMPORTED_LOCATION "${_MD3_PLUGIN_LIB}"
        )
        if (_MD3_PLUGIN_IMPLIB)
            set_target_properties(Md3plugin PROPERTIES IMPORTED_IMPLIB "${_MD3_PLUGIN_IMPLIB}")
        endif()
        if (WIN32 AND _MD3_PLUGIN_IMPLIB)
            # Qt Creator / MSVC multi-config (Debug) needs per-config implib paths.
            foreach (_cfg IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
                set_target_properties(Md3plugin PROPERTIES
                    "IMPORTED_LOCATION_${_cfg}" "${_MD3_PLUGIN_LIB}"
                    "IMPORTED_IMPLIB_${_cfg}" "${_MD3_PLUGIN_IMPLIB}"
                )
            endforeach()
        endif()
    else()
        add_library(Md3plugin STATIC IMPORTED GLOBAL)
        set_target_properties(Md3plugin PROPERTIES IMPORTED_LOCATION "${_MD3_PLUGIN_LIB}")
    endif()
endif()

# Static QML registration stubs (static packages only)
if (NOT _MD3_PACKAGE_SHARED AND NOT TARGET Md3plugin_init AND EXISTS "${_MD3_STUBDIR}")
    file(GLOB _MD3_STUBS CONFIGURE_DEPENDS "${_MD3_STUBDIR}/*.cpp")
    if (_MD3_STUBS)
        add_library(Md3plugin_init STATIC ${_MD3_STUBS})
        target_link_libraries(Md3plugin_init PUBLIC Qt6::Qml Qt6::Quick)
    endif()
endif()

# Convenience target for static whole-archive linking; shared just links normally
if (TARGET Md3plugin AND NOT TARGET Md3::QmlPlugin)
    add_library(Md3::QmlPlugin INTERFACE IMPORTED GLOBAL)
    if (_MD3_PACKAGE_SHARED)
        set_target_properties(Md3::QmlPlugin PROPERTIES
            INTERFACE_LINK_LIBRARIES "Md3::Md3"
        )
    else()
        set(_md3_qml_link "")
        list(APPEND _md3_qml_link "$<LINK_LIBRARY:WHOLE_ARCHIVE,Md3plugin>")
        if (TARGET Md3plugin_init)
            list(APPEND _md3_qml_link "$<LINK_LIBRARY:WHOLE_ARCHIVE,Md3plugin_init>")
        endif()
        list(APPEND _md3_qml_link "$<LINK_LIBRARY:WHOLE_ARCHIVE,Md3::Md3>")
        set_target_properties(Md3::QmlPlugin PROPERTIES
            INTERFACE_LINK_LIBRARIES "${_md3_qml_link}"
        )
    endif()
endif()

if (EXISTS "${_MD3_QMLDIR}")
    list(APPEND CMAKE_QML_IMPORT_PATH "${_MD3_QMLDIR}")
    set(CMAKE_QML_IMPORT_PATH "${CMAKE_QML_IMPORT_PATH}" CACHE STRING "" FORCE)
endif()

set(Md3_INCLUDE_DIRS "${_MD3_INCLUDEDIR}/Md3")
set(Md3_LIBRARIES Md3::Md3)

check_required_components(Md3)
