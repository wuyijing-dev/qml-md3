# Build trees (Qt Creator / CMake / Ninja / MSVC / MinGW)
/build/
/build-wasm/
/out/
/cmake-build-*/
/_build/
/Debug/
/Release/
/RelWithDebInfo/
/MinSizeRel/

# Qt Creator / IDE local state
/.qtcreator/
CMakeLists.txt.user*
*.pro.user*
*.qmlproject.user*
*.autosave
.vs/
.idea/
*.swp
*~

# CMake / compile artifacts outside build dir
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
*.ninja
.ninja_deps
.ninja_log

# Qt / QML generated
*.qmlc
*.jsc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_qmltyperegistrations.cpp
*.rcc/

# CMake-staged copies (canonical assets stay in /resources/)
/src/Md3/resources/
/src/Md3/icons/
/gallery/md3/

# Compiler / linker leftovers
*.obj
*.o
*.a
*.lib
*.dll
*.dylib
*.so
*.so.*
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.pch
*.gch

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Env / secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Python tooling (if any)
__pycache__/
*.py[cod]
.venv/
venv/

# MkDocs output
/site/

# Coverage / logs
*.log
coverage/
*.gcda
*.gcno

/build-lib/
/build-lib-*/
/build-mingw*/
/build-cmake-*/
/build-compat-*/
/dist/

